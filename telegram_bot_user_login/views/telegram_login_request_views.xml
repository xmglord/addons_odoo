<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_telegram_login_request_search" model="ir.ui.view">
        <field name="name">telegram.login.request.search</field>
        <field name="model">telegram.login.request</field>
        <field name="arch" type="xml">
            <search string="Search Login Requests">
                <field name="telegram_user_full_name" />
                <field name="telegram_username" />
                <field name="requested_user_id" />
                <separator />
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]" />
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]" />
                <filter string="Denied" name="denied" domain="[('state', '=', 'denied')]" />
            </search>
        </field>
    </record>

    <record id="view_telegram_login_request_list" model="ir.ui.view">
        <field name="name">telegram.login.request.list</field>
        <field name="model">telegram.login.request</field>
        <field name="arch" type="xml">
            <list
                string="Login Requests"
                create="false"
                decoration-info="state == 'pending'"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'denied'"
            >
                <field name="create_date" />
                <field name="telegram_user_full_name" />
                <field name="telegram_username" />
                <field name="requested_user_id" />
                <field name="state" />
                <field name="processed_by_id" />
                <field name="processed_date" />
            </list>
        </field>
    </record>

    <record id="view_telegram_login_request_form" model="ir.ui.view">
        <field name="name">telegram.login.request.form</field>
        <field name="model">telegram.login.request</field>
        <field name="arch" type="xml">
            <form string="Login Request" create="false" edit="false">
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'pending'"
                    />
                    <button
                        name="action_deny"
                        type="object"
                        string="Deny"
                        class="btn-danger"
                        invisible="state != 'pending'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,denied" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="telegram_user_full_name" />
                            <field name="telegram_username" />
                            <field name="requested_user_id" />
                            <field name="chat_id" options="{'no_open': True}" />
                        </group>
                        <group>
                            <field name="processed_by_id" />
                            <field name="processed_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_login_request" model="ir.actions.act_window">
        <field name="name">Login Requests</field>
        <field name="res_model">telegram.login.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No login requests yet.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_telegram_login_requests"
        name="Login Requests"
        parent="telegram_bot.menu_telegram_root"
        action="action_telegram_login_request"
        sequence="20"
    />
</odoo>
